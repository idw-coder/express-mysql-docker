# docker-compose.prod.yml の nextjs サービスが env_file で読む設定のテンプレート。
# 本番サーバーの /var/www/app/nextjs/.env にコピーして値を埋める。
# このファイル自体はテンプレートなので実際の値を書かないこと（.env は gitignore 済み）。
#
# NEXT_PUBLIC_* はビルド時にイメージへ焼き込まれるため、ここには不要。

# --- DB接続（秘匿） ---
# DB_HOST / DB_PORT / DB_NAME / DB_CONNECTION_LIMIT は compose の environment: 側で指定。
# ここに置くのは認証情報だけ。root ではなくアプリ用ユーザーを使う。
DB_USER=appuser
DB_PASSWORD=

# --- 認証 ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_GOOGLE_CALLBACK_URL=
FRONTEND_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
